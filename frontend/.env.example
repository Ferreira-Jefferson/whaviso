VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Client ID público do Google (login via Identity Services); termina em .apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
# Embedded Signup da Meta (WhatsApp Cloud API). Identificadores públicos do app Whaviso, usados pelo
# popup de conexão de número (SDK do Facebook). Nao sao segredo (o segredo e META_APP_SECRET, so no backend).
# VITE_META_GRAPH_VERSION deve ser igual ao META_API_VERSION do backend.
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
VITE_META_GRAPH_VERSION=v23.0
# (O número do WhatsApp de vendas NÃO é mais env: o front recebe o número pareado pelo zap na
# própria resposta da recarga — POST /billing/recarga -> telefone_vendas. Sem configurar nada.)
