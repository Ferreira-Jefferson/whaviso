# Config de BUILD da SPA (Vite). Carregado por deploy/scripts/deploy.sh e exportado como
# env de processo ANTES do `npm run build`. Env de processo tem precedencia maxima no Vite,
# entao o build nao depende de nenhum .env solto no servidor (um .env gitignorado antigo ja
# envenenou o build apontando para um projeto Supabase morto; isto fecha essa porta).
#
# ATENCAO: estes 4 valores sao PUBLICOS por natureza. O Vite os assa no JavaScript que vai
# para o navegador, qualquer visitante da SPA ja os le. Nao ha segredo aqui. Segredos de
# servidor (service role key, senhas de banco, SEND_CODE_HOOK_SECRET) ficam em
# /etc/whaviso/*.env e NUNCA no frontend.
#
# Override em producao sem mexer no repo: crie /etc/whaviso/frontend.env com estes nomes; o
# deploy prefere esse arquivo quando ele existe.
VITE_SUPABASE_URL=https://yrwkwgmikjbkiplvjtyx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PPO7_v9KbynkPMtpRnCR1Q_6YXafpJT
VITE_API_URL=https://api.whaviso.com
VITE_GOOGLE_CLIENT_ID=154601528680-03q09bi4ne3imsntc8lbu5l3ikf4upbg.apps.googleusercontent.com
