# Exemplo do EnvironmentFile do whaviso-atendente (:3003).
# Copiar para /etc/whaviso/atendente.env, preencher os segredos e deixar root:root 600.
# Carregado pela unit systemd (whaviso-atendente.service). NODE_ENV ja vem da unit.
#
# NUNCA versionar o arquivo real preenchido: so este exemplo com placeholders.

# Conexao ao Postgres do Supabase cloud com o role de privilegio minimo do atendente.
# SESSION POOLER (porta 5432), igual a api/zap (o transaction pooler :6543 nao serve ao app).
# TLS verificado e OBRIGATORIO: sslmode=verify-full + a CA pinada (require quebra no node-postgres,
# SELF_SIGNED_CERT_IN_CHAIN; ver deploy/README Apendice A). O role whaviso_atendente ja existe
# (migration 0001) com os grants/RLS proprios.
DATABASE_URL=postgresql://whaviso_atendente.yrwkwgmikjbkiplvjtyx:SENHA_DO_ROLE@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/etc/whaviso/supabase-root-2021-ca.crt

# Chave mestra da cifra. TEM que ser IDENTICA a dos /etc/whaviso/api.env e zap.env
# (api cifra, atendente/zap decifram a mesma base cifrada no cloud compartilhado).
MASTER_KEY=A_MESMA_MASTER_KEY_DA_API_E_DO_ZAP

# Porta do worker (default 3003). Nivel de log opcional.
PORT=3003
LOG_LEVEL=info
