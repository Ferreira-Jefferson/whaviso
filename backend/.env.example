# whaviso — template do .env ÚNICO de desenvolvimento local.
# Copie para .env (gitignored) e preencha. Produção: ver secrets/production.env.example.

# ── Postgres LOCAL (dev/testes; Postgres 18 sem Docker) ──
POSTGRES_PASSWORD=

# ── Supabase cloud ──
SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_NAME=
SUPABASE_URL=
SUPABASE_PASSWORD=
# Service role key (segredo de SERVIDOR; NUNCA no front). Usada pela api só para a
# conta-no-aceite (H1.4): cria a conta do convidado por telefone via Admin API do
# Supabase. Opcional: sem ela, o aceite só vincula por telefone (sem criar conta).
SUPABASE_SERVICE_ROLE_KEY=

# ── api (:3001) — prefixo API_ ──
API_PORT=3001
API_DATABASE_URL=postgresql://whaviso_api:whaviso_api_dev@127.0.0.1:5432/whaviso_dev
APP_URL=http://localhost:5173
# Número do WhatsApp do Whaviso (só dígitos com DDI). Usado p/ montar o link wa.me do
# CONVITE (H2.2): o devedor fala com o Whaviso, não com o cobrador. Opcional: sem ele a
# tela de convite cai no fallback de copiar a mensagem/número.
# API_WHAVISO_WHATSAPP=5511999998888
# Roteirizacao: provedor de mapas REAL (geocode por Nominatim/OSM + distancia/rota por OSRM).
# Sem estas vars, o modulo roteirizacao degrada offline (linha reta/haversine; geocode pendente).
# Preencha as 3 essenciais para ativar o provedor real (so HTTPS; respeite a politica do Nominatim,
# ~1 req/s e um contato valido no User-Agent). Nao use o servidor publico para carga pesada.
# API_MAPAS_NOMINATIM_URL=https://nominatim.openstreetmap.org
# API_MAPAS_OSRM_URL=https://router.project-osrm.org
# API_MAPAS_CONTATO=contato@seudominio.com
# API_MAPAS_USER_AGENT=whaviso/1.0 (+contato@seudominio.com)
# API_MAPAS_TIMEOUT_MS=8000
# API_MAPAS_INTERVALO_MS=1000
# Fiscal: emissor de terceiro REAL (NFC-e/NFS-e via Focus NFe) atras de ClienteFiscal. Gating por
# OPT-IN: so ativa com API_FISCAL_PROVEDOR=focusnfe. Sem isso, o modulo fiscal cai no stub
# (emissor_nao_configurado) e nada e emitido. O TOKEN do emissor NAO vai aqui: e por loja, cifrado
# no banco (PUT /fiscal/config). Go-live exige uma conta Focus NFe e os dados fiscais por item.
# API_FISCAL_PROVEDOR=focusnfe
# API_FISCAL_FOCUS_URL_HOMOLOGACAO=https://homologacao.focusnfe.com.br
# API_FISCAL_FOCUS_URL_PRODUCAO=https://api.focusnfe.com.br
# API_FISCAL_TIMEOUT_MS=15000
# Canais: integracao REAL de pedidos do iFood (API oficial de parceiro) atras de ClienteCanal.
# Gating por credencial: sem o par abaixo, o canal iFood cai no stub (501 canal_nao_integrado). O
# par clientId/clientSecret e da APLICACAO integradora (nivel app, segredo); o merchantId por loja
# e cifrado no banco (PUT /canais). Go-live exige uma conta de parceiro iFood homologada.
# API_CANAL_IFOOD_CLIENT_ID=
# API_CANAL_IFOOD_CLIENT_SECRET=
# API_CANAL_IFOOD_BASE_URL=https://merchant-api.ifood.com.br
# API_CANAL_IFOOD_TIMEOUT_MS=10000

# ── zap (:3002) — prefixo ZAP_ ──
ZAP_PORT=3002
ZAP_DATABASE_URL=postgresql://whaviso_zap:whaviso_zap_dev@127.0.0.1:5432/whaviso_dev
SCHEDULER_INTERVAL_MS=30000
# Origem do SPA p/ a CTA discreta de criar conta ao cobrador SEM conta (H10.7). Opcional:
# se ausente, o zap reaproveita o APP_URL acima (server.ts faz o alias).
# ZAP_APP_URL=http://localhost:5173

# WhatsApp pela Meta Cloud API (oficial). O zap EXIGE as 4 primeiras no boot. O token
# NUNCA é commitado. Webhook em /webhook/whatsapp (assinado por X-Hub-Signature-256).
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# META_WABA_ID=                # usado pelo sync de templates (futuro)
# META_GRAPH_URL=https://graph.facebook.com
# META_API_VERSION=v23.0
# Template AUTHENTICATION do OTP de login (nome aprovado na WABA) e idioma:
# META_OTP_TEMPLATE=whaviso_otp
# META_OTP_IDIOMA=pt_BR
# OTP do login por telefone (Send SMS Hook do Supabase). Sem o secret, /hooks/send-code responde 503.
# SEND_CODE_HOOK_SECRET=
# E-mail transacional (Resend) para o boas-vindas da allowlist de login. Opcional: sem a
# chave o dreno de e-mail fica idle (fila retida; o boot nao quebra). SEGREDO (servidor so,
# nunca no front). O dominio do remetente precisa ser verificado no Resend (DNS).
# ZAP_RESEND_API_KEY=
# ZAP_RESEND_REMETENTE=Whaviso <nao-responda@whaviso.com>

# ── frontend (React + Vite SPA, servido por nginx na VPS) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:3001

# ── compartilhado ──
LOG_LEVEL=info
