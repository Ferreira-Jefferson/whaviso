# whaviso: TEMPLATE dos segredos de produção.
# Copie para secrets/production.env (gitignored) e preencha os valores reais.
# Deploy é VPS + nginx (NÃO Vercel). As strings de banco usam o session pooler :5432
# (nunca :6543): o app usa FOR UPDATE SKIP LOCKED, pools longos e LISTEN, que o
# transaction pooler não suporta. Ver deploy/README.md (Apêndice A).

# ══ MIGRATIONS / superusuário (supabase db push, psql, ALTER ROLE) ══
# Senha do role postgres do cloud, percent-encoded na URL (# => %23).
SUPABASE_DB_PASSWORD=
MIGRATIONS_DB_URL=

# ══ API (host: api.whaviso.com => 127.0.0.1:3001) ══
# user whaviso_api; senha definida via ALTER ROLE ao rodar as migrations (ver README).
API_DATABASE_URL=
# Conexão de LISTEN do realtime/cache (precisa de sessão; o session pooler :5432 serve).
# Pode espelhar a API_DATABASE_URL.
DATABASE_URL_LISTEN=
SUPABASE_URL=
APP_URL=
# Service role: usada pela api E pelo zap (Admin API do Supabase).
SUPABASE_SERVICE_ROLE_KEY=

# ══ ZAP (host: api.whaviso.com/hooks/ => 127.0.0.1:3002) ══
ZAP_DATABASE_URL=
# WhatsApp via Meta Cloud API (oficial). O zap fala com a Graph API por HTTP (sem
# socket, sem QR): a conexão é por credenciais. As 4 primeiras são exigidas no boot.
META_ACCESS_TOKEN=       # token permanente do System User (messaging + management)
META_PHONE_NUMBER_ID=    # Phone number ID (WhatsApp Manager / API Setup)
META_WABA_ID=            # WhatsApp Business Account ID
META_APP_SECRET=         # app secret (valida a assinatura do webhook)
META_VERIFY_TOKEN=       # token do handshake do webhook (você escolhe)
META_GRAPH_URL=https://graph.facebook.com
META_API_VERSION=v23.0
# OTP do login por telefone (Send SMS Hook do Supabase => /hooks/send-code do zap).
# Mesmo valor nos dois lados (zap e painel Supabase > Auth > Hooks).
SEND_CODE_HOOK_SECRET=

# ══ ATENDENTE (worker de conversa IA, :3003) ══
# user whaviso_atendente; senha definida via ALTER ROLE ao rodar as migrations.
ATENDENTE_DATABASE_URL=
# Chave da OpenRouter (embeddings do RAG / LLM do atendente).
OPEN_ROUTER=

# ══ FRONTEND (SPA React+Vite, build estático servido pelo nginx em whaviso.com) ══
# A publishable key é pública por design (sai no bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=

# ══ CIFRA (kernel AES-256-GCM): iguais ao dev (gotcha do corte: cifra não decifra se mudar) ══
MASTER_KEY=
LLM_MASTER_KEY=

# ══ VPS / Git (referência operacional; não vai pros envs dos serviços) ══
SSH_HOST=
# Senha de console da VPS, a MESMA para root e para deploy (console de emergência / sudo).
# SSH de root está desativado; login normal é deploy + chave id_ed25519 (sem senha).
ROOT_PASSWORD=
GH_TOKEN=
