# whaviso — template dos SEGREDOS DE PRODUÇÃO.
# Copie para secrets/production.env (gitignored) e preencha os valores reais.
# Deploy é VPS + nginx (NÃO Vercel). Strings de banco: SEMPRE session pooler :5432
# (nunca :6543), por causa de FOR UPDATE SKIP LOCKED, pools longos e LISTEN.
# Ver deploy/README.md (Apêndice A). Senhas com caractere especial na URL: percent-encode (# => %23).

# ══ MIGRATIONS / superusuário (supabase db push, psql, ALTER ROLE) ══
SUPABASE_DB_PASSWORD=          # senha do role `postgres` do cloud
MIGRATIONS_DB_URL=            # postgresql://postgres.<ref>:<senha-encoded>@aws-1-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require

# ══ API (host: api.whaviso.com → :3001) ══
API_DATABASE_URL=            # postgresql://whaviso_api.<ref>:<senha>@aws-1-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_LISTEN=         # conexão de sessão p/ LISTEN (pode espelhar a API_DATABASE_URL)
SUPABASE_URL=               # https://<ref>.supabase.co
APP_URL=https://whaviso.com  # origem do SPA (usada pelo CORS)
SUPABASE_SERVICE_ROLE_KEY=  # service role (usada pela api E pelo zap: Admin API)

# ══ ZAP (host: api.whaviso.com/hooks/ → :3002) ══
ZAP_DATABASE_URL=           # postgresql://whaviso_zap.<ref>:<senha>@aws-1-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# WhatsApp via Meta Cloud API (oficial). As 4 primeiras são exigidas no boot do zap.
META_ACCESS_TOKEN=          # token permanente do System User (messaging + management)
META_PHONE_NUMBER_ID=       # Phone number ID (WhatsApp Manager / API Setup)
META_WABA_ID=               # WhatsApp Business Account ID
META_APP_SECRET=            # app secret (valida a assinatura do webhook)
META_VERIFY_TOKEN=          # token do handshake do webhook (você escolhe)
META_GRAPH_URL=https://graph.facebook.com
META_API_VERSION=v23.0
# SEND_CODE_HOOK_SECRET=    # OTP do login por telefone (mesmo valor no zap e no painel Supabase)

# ══ ATENDENTE (worker de conversa IA, :3003) ══
ATENDENTE_DATABASE_URL=     # postgresql://whaviso_atendente.<ref>:<senha>@aws-1-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
OPEN_ROUTER=               # chave da OpenRouter (embeddings do RAG / LLM do atendente)

# ══ FRONTEND (SPA React+Vite, build estático servido pelo nginx) ══
VITE_SUPABASE_URL=         # https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=  # publishable key (pública por design, sai no bundle)
VITE_API_URL=https://api.whaviso.com
VITE_GOOGLE_CLIENT_ID=     # client id do Google OAuth

# ══ CIFRA (kernel AES-256-GCM) — igual ao dev (a cifra não decifra se a chave mudar) ══
MASTER_KEY=                # >= 32 caracteres
LLM_MASTER_KEY=            # >= 32 caracteres

# ══ VPS / Git (referência operacional; não vai pros envs dos serviços) ══
SSH_HOST=                  # deploy@<ip-da-vps>
ROOT_PASSWORD=             # senha de console do root da VPS (SSH de root desativado)
GH_TOKEN=                  # PAT do GitHub (operações de git no servidor)
